# Copy to `.env` — NEVER commit real values (Constitution: no secrets in repo).

# Sepolia JSON-RPC endpoint (Alchemy / Infura / etc.)
RPC_URL=

# Deployer private key — testnet-only account funded with Sepolia ETH. NEVER commit.
DEPLOYER_KEY=

# Contract addresses — mirror the `factory` / `nft` keys of deployments/sepolia.json
FACTORY_ADDRESS=
NFT_ADDRESS=

# Backend HTTP port (defaults to 3001 when unset)
PORT=

# WalletConnect Cloud project id (https://cloud.walletconnect.com)
WALLETCONNECT_PROJECT_ID=

# SQLite index database path (backend)
DATABASE_PATH=./data/index.db
