# Copy to `.env` - NEVER commit real values (Constitution: no secrets in repo).

# Sepolia JSON-RPC endpoint used by the browser app (viem transport)
VITE_RPC_URL=

# Contract addresses - mirror the `factory` / `nft` keys of deployments/sepolia.json
VITE_FACTORY_ADDRESS=
VITE_NFT_ADDRESS=

# WalletConnect Cloud project id (https://cloud.walletconnect.com)
# Leave empty to run with the injected (browser) connector only
VITE_WALLETCONNECT_PROJECT_ID=

# Optional: backend API base URL (defaults to same-origin /api via the dev proxy)
VITE_API_BASE=
