# Frontend build-time env. Copy to .env.local (gitignored) and fill, or run:
#   node scripts/sync-deployments.mjs
# Keep in sync with deployments/sepolia.json.

# Optional: browser RPC endpoint (defaults to a public Sepolia RPC when unset)
VITE_RPC_URL=

# Deployed contract addresses (required for a real network)
VITE_FACTORY_ADDRESS=
VITE_NFT_ADDRESS=

# Optional: WalletConnect Cloud project id (injected wallets work without it)
VITE_WALLETCONNECT_PROJECT_ID=

# Optional: IPFS gateway prefix for ipfs:// metadata/images (a dedicated
# gateway such as Pinata's avoids public ipfs.io rate limits).
# A bare origin is normalized to <origin>/ipfs/. Defaults to https://ipfs.io
VITE_IPFS_GATEWAY=
